{
  "name": "ha-sun-moon-card",
  "version": "1.0.1",
  "description": "Moderne Home Assistant Lovelace Card für Sonnenstand, Sonnenverlauf, Dämmerungsphasen und Monddaten.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "sun",
    "moon",
    "twilight",
    "astronomy"
  ],
  "homepage": "https://github.com/cercytrone/ha-sun-moon-card",
  "repository": {
    "type": "git",
    "url": "https://github.com/cercytrone/ha-sun-moon-card.git"
  },
  "bugs": {
    "url": "https://github.com/cercytrone/ha-sun-moon-card/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/sun-moon-card.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "lint:fix": "eslint . --fix",
    "screenshots": "node tools/screenshot.mjs",
    "verify:layout": "node tools/verify-layout.mjs"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
